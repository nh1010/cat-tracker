APP_ENV=development
PORT=5000
SQLITE_DB_PATH=data/cat.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cattracker.nyc
CORS_ALLOW_CREDENTIALS=false
CAPTCHA_REQUIRED=false
TURNSTILE_SECRET_KEY=
ADMIN_API_KEY=change_me_for_reports
TRUST_PROXY_HEADERS=false

# Local development falls back to UPLOAD_DIR when S3_BUCKET is empty.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000

# Production uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
S3_BUCKET=cdk_output_MediaBucketName
S3_UPLOAD_PREFIX=uploads
S3_PUBLIC_BASE_URL=cdk_output_MediaPublicBaseUrl

# Simple per-IP fixed-window rate limits
RATE_LIMIT_WINDOW_SECONDS=60
WRITE_RATE_LIMIT=20
UPLOAD_RATE_LIMIT=10
EXPORT_RATE_LIMIT=10
